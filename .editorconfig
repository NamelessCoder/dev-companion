root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# PER-CS 3.0, which .php-cs-fixer.dist.php declares and rewrites every file to.
[*.php]
indent_size = 4

[*.{neon,xml,xml.dist}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# A directive's content is what the indentation means here, so it is wider than
# the default to keep a nested one legible. `Rst::INDENT` is what writes it.
[*.rst]
indent_size = 4
trim_trailing_whitespace = false
