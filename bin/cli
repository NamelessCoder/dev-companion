#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * The upkeep of this repository, in one command that says what it supports.
 *
 * Run it with nothing to see every subject and every command it carries. What
 * each of them does is declared beside the code that does it, in
 * src/Upkeep/Cli/, and the help is generated from those declarations.
 *
 * The server itself is bin/typo3-cms-mcp, and stays out of this.
 */

