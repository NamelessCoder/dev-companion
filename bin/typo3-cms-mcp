#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Stdio MCP transport for the TYPO3 core knowledge base.
 *
 * The only entrypoint: Claude Code (or any MCP client) launches this as a
 * subprocess and speaks JSON-RPC over stdin/stdout. No auth — the process
 * boundary is the trust boundary. The server itself is built by ServerFactory.
 *
 * This is also the one place that hands a working directory to Instance. The
 * client starts this process inside the session it is working in, so the
 * working directory is the agent's own and an installation found from it is the
 * one being worked on. Nothing else may do this: a request-serving endpoint has
 * no such relationship to its callers, and its document root may itself sit
 * inside a TYPO3 installation.
 */

use Mcp\Server\Transport\StdioTransport;
use Typo3CmsMcp\Instance;
use Typo3CmsMcp\Installer;
use Typo3CmsMcp\ServerFactory;

require dirname(__DIR__) . '/src/bootstrap.php';

if (in_array($argv[1] ?? null, ['install', 'update'], true)) {
    $directory = getcwd();
    if ($directory === false) {
        fwrite(STDERR, "typo3-cms-mcp: cannot determine the current directory.\n");
        exit(1);
    }

    $agent = null;
    foreach (array_slice($argv, 2) as $argument) {
        if (str_starts_with($argument, '--agent=')) {
            $agent = substr($argument, strlen('--agent='));
        }
    }
    $entrypoint = realpath($argv[0]) ?: $argv[0];
    try {
        $installer = new Installer($directory, $entrypoint);
        $message = $argv[1] === 'install'
            ? $installer->install($agent)
            : $installer->update($agent ?? '');
    } catch (\RuntimeException $exception) {
        fwrite(STDERR, 'typo3-cms-mcp: ' . $exception->getMessage() . ".\n");
        exit(1);
    }

    fwrite(STDOUT, $message . "\n");
    exit(0);
}

Instance::discoverFrom(getcwd() ?: null);

ServerFactory::create()->run(new StdioTransport());
