#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Stdio MCP transport for the TYPO3 core knowledge base.
 *
 * Local-dev entrypoint: Claude Code (or any MCP client) launches this as a
 * subprocess and speaks JSON-RPC over stdin/stdout. No auth — the process
 * boundary is the trust boundary. The HTTP entrypoint (public/index.php) stays
 * the path for shared hosting. Both build the same server via ServerFactory.
 */

use Mcp\Server\Transport\StdioTransport;
use Typo3CmsMcp\ServerFactory;

require dirname(__DIR__) . '/vendor/autoload.php';

ServerFactory::create()->run(new StdioTransport());
