#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * The MCP server. A client launches this as a subprocess and speaks JSON-RPC
 * over stdin and stdout; there is no auth, because the process boundary is the
 * trust boundary.
 *
 * What it supports is declared beside the code that does it, in src/Server/.
 * The upkeep of this repository is bin/cli, and stays out of this.
 */

require dirname(__DIR__) . '/src/bootstrap.php';

use TYPO3\DevCompanion\Server\Entrypoint;

exit(Entrypoint::run(array_slice($argv, 1), realpath($argv[0]) ?: $argv[0]));
