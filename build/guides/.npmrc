# npm 12 refuses git dependencies unless told otherwise, and the design system
# is consumed as one — `github:benjaminkott/typo3-soul-design-system#<sha>` in
# package.json. Without this the install fails with EALLOWGIT, on this machine
# and on the runner alike, and the site cannot be built at all.
#
# In the repository rather than in anyone's ~/.npmrc, so the runner and every
# clone agree without a setup step nobody remembers.
allow-git=all
