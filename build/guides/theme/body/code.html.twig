{#
    A fenced block is the design system's code element.

    The element frames it, colours it from its own `lang`, and owns the copy
    button and the caption. Naming the language here and again on a `<code>`
    would let the head and the colouring disagree unnoticed.

    Without JavaScript the block is unframed but readable — the element renders
    light DOM and its frame arrives on upgrade. This page already needs a script
    for the search and for the drawings.
#}
{% if node.raw %}
    {# The RawDirective passes markup through; framing it would be wrong. #}
    {{ node.value|raw }}
{%- else -%}
    <sds-code lang="{{ node.language }}"{% if node.caption %} caption="{{ renderNode(node.caption)|striptags|trim }}"{% endif %} copy>{% include "body/code/highlighted-code.html.twig" %}</sds-code>
{%~ endif -%}
