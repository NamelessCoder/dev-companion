{#
    Every table on this site is the design system's table component.

    Overriding the class hook rather than `body/table.html.twig` itself: the
    renderer's own template composes six partials, and copying all of that here
    to add one class would mean owning six files that the renderer will keep
    changing under us. This is the one seam that exists for exactly this.

    `sds-table` at its default density is medium — the one for rows that are
    read rather than scanned, which is what a table in prose is. Compact is for
    a list that IS the work; no page here has one.

    The classes the renderer computes are kept: `align-*`, `colwidths-*` and
    anything a directive set are its own vocabulary and still mean something.
#}
{%- set tableClasses = 'sds-table sds-table--scroll ' -%}

{%- if tableNode.classes -%}
    {%- set tableClasses = tableClasses ~ tableNode.classesString ~ ' ' -%}
{%- endif -%}
{%- if tableNode.hasOption('align') -%}
    {%- set tableClasses = tableClasses ~ 'align-' ~ tableNode.option('align') ~ ' ' -%}
{%- endif -%}
{%- if tableNode.hasOption('widths') -%}
    {%- set tableClasses = tableClasses ~ 'colwidths-' ~ tableNode.option('widths') ~ ' ' -%}
{%- endif -%}
{%- if tableNode.hasOption('grid') == 'grid' -%}
    {%- set tableClasses = tableClasses ~ 'grid-' ~ tableNode.option('grid') ~ ' ' -%}
{%- endif -%}

{%- if tableClasses|trim %} class="{{ tableClasses|trim }}"{% endif -%}
