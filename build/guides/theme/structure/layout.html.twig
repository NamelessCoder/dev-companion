{#
    The page every rendered document is written into.

    It shadows the same path in phpDocumentor's default theme, which produces
    a bare document with no way to leave it. The navigation is built here from
    `allDocumentEntries` rather than from a toctree, because a toctree is a
    reStructuredText directive and this corpus is markdown.

    The stylesheet is inlined. It is 4 KB against pages of up to 88 KB, and an
    external file would need a copier, a path that survives a subdirectory, and
    a cache buster — three moving parts to save nothing.
#}
{% set here = env.currentFileName %}
{% set depth = here|split('/')|length - 1 %}
{% set up = '' %}
{% if depth > 0 %}{% for i in 1..depth %}{% set up = up ~ '../' %}{% endfor %}{% endif %}
{% set pages = env.allDocuments|sort((a, b) => a.filePath <=> b.filePath) %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}
        {%- if title != null and env.projectNode.title != null %} — {% endif -%}
        {%- if env.projectNode.title -%}{{ env.projectNode.title }}{%- endif -%}</title>
    <style>
    :root {
        --ink: #1a1a1a; --dim: #5c5c5c; --line: #e0e0e0; --bg: #fff;
        --soft: #f7f7f6; --link: #0b5cad; --mark: #e8710a;
    }
    @media (prefers-color-scheme: dark) {
        :root {
            --ink: #e8e6e3; --dim: #a0a0a0; --line: #33322f; --bg: #1b1b19;
            --soft: #232320; --link: #7ab7f0; --mark: #f5a35c;
        }
    }
    * { box-sizing: border-box; }
    body {
        margin: 0; background: var(--bg); color: var(--ink);
        font: 16px/1.65 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    a { color: var(--link); }
    .wrap { display: flex; align-items: flex-start; max-width: 1180px; margin: 0 auto; }
    nav.side {
        flex: 0 0 17rem; position: sticky; top: 0; align-self: flex-start;
        max-height: 100vh; overflow-y: auto; padding: 1.6rem 1rem 3rem;
        border-right: 1px solid var(--line); font-size: 14px;
    }
    nav.side .brand {
        display: block; font-weight: 600; font-size: 15px; letter-spacing: .01em;
        color: var(--ink); text-decoration: none; padding-bottom: .9rem;
        margin-bottom: .6rem; border-bottom: 1px solid var(--line);
    }
    nav.side h2 {
        font-size: 11px; text-transform: uppercase; letter-spacing: .09em;
        color: var(--dim); margin: 1.4rem 0 .4rem; font-weight: 600;
    }
    nav.side #q {
        width: 100%; margin: .2rem 0 .4rem; padding: .35rem .5rem;
        font: inherit; font-size: 13px; color: var(--ink);
        background: var(--bg); border: 1px solid var(--line); border-radius: 3px;
    }
    nav.side #q:focus { outline: 2px solid var(--link); outline-offset: -1px; }
    nav.side #miss { color: var(--dim); font-size: 13px; padding: .3rem .5rem; }
    nav.side a.page small {
        display: block; color: var(--dim); font-size: 11.5px;
        line-height: 1.4; font-weight: 400; margin-top: .1rem;
    }
    nav.side #hits a.page { padding: .35rem .5rem; }
    nav.side ul { list-style: none; margin: 0; padding: 0; }
    nav.side li { margin: 0; }
    nav.side a.page {
        display: block; padding: .2rem .5rem; border-radius: 3px;
        color: var(--ink); text-decoration: none; overflow-wrap: anywhere;
    }
    nav.side a.page:hover { background: var(--soft); }
    nav.side a.page.current {
        background: var(--soft); color: var(--mark); font-weight: 600;
        box-shadow: inset 2px 0 0 var(--mark);
    }
    main { flex: 1 1 auto; min-width: 0; padding: 2.4rem 2rem 6rem; }
    main > .section > h1:first-child { margin-top: 0; }
    h1, h2, h3, h4 { line-height: 1.25; margin: 2.2rem 0 .8rem; }
    h1 { font-size: 1.9rem; letter-spacing: -.01em; }
    h2 { font-size: 1.35rem; padding-top: .6rem; border-top: 1px solid var(--line); }
    h3 { font-size: 1.1rem; }
    p, li { max-width: 44rem; }
    code {
        font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
        font-size: .87em; background: var(--soft); padding: .1em .35em; border-radius: 3px;
    }
    pre {
        background: var(--soft); border: 1px solid var(--line); border-radius: 4px;
        padding: .9rem 1rem; overflow-x: auto;
    }
    pre code { background: none; padding: 0; font-size: .85em; line-height: 1.5; }
    table { border-collapse: collapse; display: block; overflow-x: auto; max-width: 100%; }
    th, td { border: 1px solid var(--line); padding: .4rem .7rem; text-align: left; vertical-align: top; }
    th { background: var(--soft); }
    img, svg { max-width: 100%; height: auto; }
    blockquote {
        margin: 1rem 0; padding: .2rem 0 .2rem 1rem;
        border-left: 3px solid var(--line); color: var(--dim);
    }
    @media (max-width: 860px) {
        .wrap { display: block; }
        nav.side {
            position: static; max-height: none; width: auto;
            border-right: 0; border-bottom: 1px solid var(--line);
        }
        main { padding: 1.6rem 1.1rem 4rem; }
    }
    </style>
    {%~ block head %}
    {%~ endblock %}
</head>
<body>
<div class="wrap">
    <nav class="side">
        <a class="brand" href="{{ up }}index.html">{{ env.projectNode.title ?? 'Documentation' }}</a>
        <input id="q" type="search" autocomplete="off" placeholder="Search" aria-label="Search the documentation">
        <ul id="hits" hidden></ul>
        <p id="miss" hidden>Nothing carries that.</p>
        {% set group = '__none__' %}
        <ul id="pages">
        {%- for entry in pages -%}
            {%- set path = entry.filePath|trim('/') -%}
            {%- set dir = path matches '#/#' ? path|split('/')|first : '' -%}
            {%- if dir != group -%}
                {%- set group = dir -%}
                {%- if dir != '' %}<li><h2>{{ dir|replace({'-': ' '}) }}</h2></li>{% endif -%}
            {%- endif -%}
            <li><a class="page{{ path == here ? ' current' : '' }}" href="{{ up }}{{ path }}.html">{{ entry.title ? entry.title.toString : path }}</a></li>
        {%- endfor -%}
        </ul>
    </nav>
    <main>
<!-- content start -->
{%~ block body %}
{%~ endblock %}
<!-- content end -->
    </main>
</div>
<script>
// The index is fetched on the first keystroke and never before: a reader who
// does not search pays nothing for one that is 213 KB.
(function () {
    var box = document.getElementById('q'),
        hits = document.getElementById('hits'),
        miss = document.getElementById('miss'),
        pages = document.getElementById('pages'),
        up = {{ up|json_encode|raw }},
        index = null, pending = false;

    function terms(value) {
        return value.toLowerCase().split(/[^a-z0-9_:.-]+/).filter(function (t) { return t.length > 1; });
    }

    // A title carries what a page is; a heading what a section is; the prose
    // only that the word occurs. Scored in that order, so the page named after
    // the question outranks the one that mentions it.
    //
    // The prose is scored by how often, capped: a word nobody put in a heading
    // is otherwise worth the same on the page about it and on the one that
    // names it once in passing. The cap keeps a long page from winning on
    // length alone.
    function score(page, words) {
        var title = page.title.toLowerCase(),
            heads = page.headings.join(' ').toLowerCase(),
            text = page.text.toLowerCase(),
            total = 0;
        for (var i = 0; i < words.length; i++) {
            var word = words[i], had = 0, times = text.split(word).length - 1;
            if (title.indexOf(word) !== -1) { total += 10; had = 1; }
            if (heads.indexOf(word) !== -1) { total += 4; had = 1; }
            if (times) { total += Math.min(times, 6); had = 1; }
            if (!had) { return 0; }
        }
        return total;
    }

    function snippet(page, word) {
        var at = page.text.toLowerCase().indexOf(word);
        if (at === -1) { return page.headings.slice(0, 2).join(' · '); }
        var from = Math.max(0, at - 40);
        return (from ? '…' : '') + page.text.slice(from, from + 130).trim() + '…';
    }

    function render(value) {
        var words = terms(value);
        if (!words.length || !index) {
            hits.hidden = true; miss.hidden = true; pages.hidden = false;
            return;
        }
        var found = [];
        for (var i = 0; i < index.length; i++) {
            var points = score(index[i], words);
            if (points) { found.push({ page: index[i], points: points }); }
        }
        found.sort(function (a, b) { return b.points - a.points; });
        pages.hidden = true;
        hits.textContent = '';
        found.slice(0, 12).forEach(function (found) {
            var li = document.createElement('li'),
                a = document.createElement('a'),
                small = document.createElement('small');
            a.className = 'page';
            a.href = up + found.page.url;
            a.textContent = found.page.title;
            small.textContent = snippet(found.page, words[0]);
            a.appendChild(small);
            li.appendChild(a);
            hits.appendChild(li);
        });
        hits.hidden = found.length === 0;
        miss.hidden = found.length !== 0;
    }

    box.addEventListener('input', function () {
        if (index || pending) { render(box.value); return; }
        pending = true;
        fetch(up + 'search.json').then(function (answer) { return answer.json(); }).then(function (loaded) {
            index = loaded;
            render(box.value);
        }).catch(function () { pending = false; });
    });
})();
</script>
</body>
</html>
