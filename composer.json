{
    "name": "typo3/cms-mcp",
    "description": "Local stdio MCP server exposing a curated TYPO3 knowledge base, the core contribution process included.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-dom": "*",
        "mcp/sdk": "^0.7.0",
        "symfony/finder": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Typo3CmsMcp\\": "src/"
        }
    },
    "bin": [
        "bin/typo3-cms-mcp"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "symfony/console": "^7.4"
    },
    "autoload-dev": {
        "psr-4": {
            "Typo3CmsMcp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "find bin -type f -print0 | xargs -0 -n1 php -l > /dev/null",
            "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null"
        ],
        "cgl": "php-cs-fixer fix --diff",
        "cgl:ci": "php-cs-fixer fix --diff --dry-run",
        "stan": "phpstan analyse",
        "test": "phpunit",
        "ci": [
            "@lint",
            "@cgl:ci",
            "@stan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "lint": "Check every PHP file for syntax errors.",
        "cgl": "Bring every PHP file to the coding guidelines.",
        "cgl:ci": "Report what cgl would change, and change nothing.",
        "stan": "Run the static analysis.",
        "test": "Run the test suite.",
        "ci": "Everything CI runs: lint, coding guidelines, static analysis, tests."
    }
}
