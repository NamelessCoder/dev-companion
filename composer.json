{
    "name": "typo3/cms-mcp",
    "description": "Local stdio MCP server exposing a curated TYPO3 core contribution knowledge base.",
    "type": "library",
    "license": "MIT",
    "require": {
        "ext-curl": "*",
        "ext-dom": "*",
        "php": ">=8.2",
        "mcp/sdk": "^0.7.0",
        "symfony/yaml": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Typo3CmsMcp\\": "src/"
        }
    },
    "bin": [
        "bin/typo3-cms-mcp"
    ],
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Typo3CmsMcp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "php -l bin/typo3-cms-mcp > /dev/null",
            "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null"
        ],
        "stan": "phpstan analyse",
        "test": "phpunit",
        "ci": [
            "@lint",
            "@stan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "lint": "Check every PHP file for syntax errors.",
        "stan": "Run the static analysis.",
        "test": "Run the test suite.",
        "ci": "Everything CI runs: lint, static analysis, tests."
    }
}
