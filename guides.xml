<?xml version="1.0" encoding="UTF-8" ?>
<!--
    The published documentation. What is rendered is not `documentation/` itself
    but the copy `bin/cli documentation:render` writes, because only that copy
    has the links a reader without the checkout can follow. That command runs
    this renderer as one of its steps, so it is what a person types:

        bin/cli documentation:render

    An error fails the build and a warning does not, because one warning stands
    that this repository will not remove: `typo3_icon_lookup` describes itself
    with the Fluid tag `<core:icon>`, which CommonMark reads as an autolink and
    the renderer then cannot resolve. That sentence is the tool's `description`,
    which is what a client reads, and it is not rewritten to suit a renderer.

    What the warning would otherwise have guarded is held in the suite instead,
    by `SiteTest::noPublishedLinkNamesAHeadingInAnotherPage`.
-->
<guides
    xmlns="https://www.phpdoc.org/guides"
    input=".site/source"
    output=".site/html"
    input-format="md"
    theme="soul"
    fail-on-error="true"
    links-are-relative="true"
>
    <project title="TYPO3 Dev Companion"/>
    <!--
        The rail and the trail, out of the directories this corpus already has.
        A menu is otherwise a toctree, which is a reStructuredText directive
        this corpus cannot write: with this on, a page belongs to the `index.md`
        of the directory it sits in, and the Markdown parser stops marking every
        document an orphan.
    -->
    <automatic-menu>true</automatic-menu>
    <extension class="phpDocumentor\Guides\Markdown\DependencyInjection\MarkdownExtension"/>
    <!-- The highlighter the theme's code block colours on the server with. -->
    <extension class="phpDocumentor\Guides\Code\DependencyInjection\CodeExtension"/>
    <!--
        The theme `theme="soul"` selects: this element is what makes it exist,
        and everything the bar, the tab and the footer say that is not the
        project title is set here rather than in a template copied into this
        checkout.
    -->
    <extension class="TYPO3\Soul\GuidesTheme\DependencyInjection\SoulExtension">
        <signet>images/signet-m.svg</signet>
        <!--
            The mark is redrawn per optical size rather than scaled, and a
            browser picks between the files by the slot it needs — which a
            media query inside one file cannot do, since it only ever sees its
            own viewport.
        -->
        <favicon href="images/signet-s.svg" sizes="16x16"/>
        <favicon href="images/signet-l.svg" sizes="32x32"/>
        <brand>TYPO3</brand>
        <product>Dev Companion</product>
        <footer>
            <social href="https://github.com/benjaminkott/typo3-cms-mcp" label="GitHub"/>
            <note>Not an official TYPO3 project.</note>
        </footer>
    </extension>
</guides>
