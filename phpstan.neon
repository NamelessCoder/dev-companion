parameters:
    level: 6
    # The result cache stores absolute paths, and without this it goes to
    # /tmp/phpstan, which every checkout on the machine shares. One entry naming
    # a directory that has since been deleted — a removed worktree — then fails
    # the analysis of every other checkout, with an internal error naming a path
    # the caller has never heard of.
    tmpDir: .phpstan.cache
    paths:
        - bin
        - src
        - tests
    # src/Installation/probe.php is not this server's code path: it is delivered
    # to the discovered installation and runs there, against TYPO3 classes this
    # repository deliberately does not depend on. Analysing it here would mean
    # requiring the core to analyse a file that never executes in this process.
    excludePaths:
        - src/Installation/probe.php
